# ============================================================
# MedVision AI v2.1 – Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgresql://medvision:medvision_secret@localhost:5432/medvision_ai
SECRET_KEY=your-super-secret-key-minimum-32-characters-change-this

# ── LLM — Pick ONE (or more; priority: Gemini → OpenAI → Ollama) ───────────

# Option A: Google Gemini 1.5 Flash (recommended — generous free tier)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option C: Ollama (fully local, no API key, requires Ollama installed)
# Install: https://ollama.com  then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── RAG (Retrieval-Augmented Generation) ────────────────────
# Requires: pip install sentence-transformers faiss-cpu
# Embedding model is downloaded once (~80 MB) on first use.
RAG_ENABLED=true
RAG_TOP_K=6
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── File uploads ─────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── App metadata ──────────────────────────────────────────────
APP_TITLE=MedVision AI
APP_VERSION=2.1.0

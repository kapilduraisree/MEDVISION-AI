# ============================================================
# MedVision AI – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://medvision:medvision_secret@localhost:5432/medvision_ai

# ----- Security -----
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- AI / LLM APIs (optional – system uses mock if not set) -----
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ----- File Storage -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ----- Speech / TTS -----
# Uses browser Web Speech API by default; set keys for server-side TTS
GOOGLE_CLOUD_TTS_KEY=

# ----- Email (optional – for notifications) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword

# ----- App -----
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
